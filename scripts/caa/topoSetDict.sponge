FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Optional: create outletSpongeZone for system/fvOptions.caa.sponge
//   cp scripts/caa/topoSetDict.sponge system/topoSetDict && topoSet
// ************************************************************************* //

actions
(
    {
        name    outletSpongeCellSet;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (12 -4 0) (15 4 8);   // last 3 m before outlet
    }
    {
        name    outletSpongeZone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     outletSpongeCellSet;
    }
);


// ************************************************************************* //
