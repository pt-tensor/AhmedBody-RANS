FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// STAGE 3 — same IDDES closure as Stage 2 (do not switch mid-acquisition)
//
// Pure-LES alternative (WALE) if wall-resolved mesh (y+~1) is confirmed:
//   LES { LESModel Wale; delta cubeRootVol; printCoeffs on; turbulence on; }
// ************************************************************************* //

simulationType      LES;

LES
{
    LESModel        kOmegaSSTIDDES;

    turbulence      on;
    printCoeffs     on;

    delta           IDDESDelta;
}


