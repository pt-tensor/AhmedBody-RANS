FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Air at standard conditions (incompressible / low-Mach Ma≈0.117 @ 40 m/s).
// ρ∞ = 1.225 kg/m³ used in acoustic post-processing (kinematic p · ρ → Pa).
// Re_H = U∞ · H / ν = 40 · 0.288 / 1.5e-5 ≈ 7.68e5
// ************************************************************************* //

transportModel  Newtonian;

nu              [0 2 -1 0 0 0 0] 1.5e-05;


